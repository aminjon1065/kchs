# ─── kchs: пример конфигурации ────────────────────────────────────────────────
# Скопируйте в .env и заполните секреты: bash infra/scripts/generate-secrets.sh
# Валидация схемой zod при старте api (apps/api/src/shared/config).

NODE_ENV=development
TZ=Asia/Dushanbe
KCHS_BASE_URL=http://localhost:5173
KCHS_API_URL=http://localhost:3000
# Каким прокси верить в X-Forwarded-For (адрес клиента для лимитов и аудита).
# Разработка: loopback; за Caddy в Docker: uniquelocal. Значение true запрещено.
TRUST_PROXY=loopback
# Лимит запросов в минуту на пользователя; для прогонов e2e одним пользователем — выше
# RATE_LIMIT_PER_MINUTE=600
# Попыток входа в минуту с одного адреса (вся организация за NAT); с одного адреса
# на один логин — 10 в минуту, это не настраивается
# LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=300

# ─── Процесс ──────────────────────────────────────────────────────────────────
# api | worker | all
ROLE=all
PORT=3000
LOG_LEVEL=debug

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=kchs
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=__CHANGE_ME__
KCHS_APP_PASSWORD=__CHANGE_ME__
KCHS_MIGRATOR_PASSWORD=__CHANGE_ME__
KCHS_QUERY_PASSWORD=__CHANGE_ME__
KCHS_READONLY_PASSWORD=__CHANGE_ME__
KCHS_AUDIT_PASSWORD=__CHANGE_ME__

DATABASE_URL=postgres://kchs_app:__CHANGE_ME__@localhost:5432/kchs
DATABASE_MIGRATOR_URL=postgres://kchs_migrator:__CHANGE_ME__@localhost:5432/kchs
DATABASE_QUERY_URL=postgres://kchs_query:__CHANGE_ME__@localhost:5432/kchs
DATABASE_POOL_MAX=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__CHANGE_ME__
REDIS_PORT=6379
REDIS_URL=redis://:__CHANGE_ME__@localhost:6379

# ─── Объектное хранилище (MinIO / S3) ─────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
# Адрес хранилища для браузера (подписанные ссылки загрузки и превью)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kchsadmin
S3_SECRET_KEY=__CHANGE_ME__
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET_FILES=kchs-files
S3_BUCKET_PREVIEWS=kchs-previews
S3_BUCKET_MEDIA=kchs-media
S3_BUCKET_EXPORTS=kchs-exports
S3_BUCKET_TILES=kchs-tiles
S3_FORCE_PATH_STYLE=true

# ─── Поиск ────────────────────────────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=__CHANGE_ME__
MEILI_PORT=7700
MEILI_ENV=development

# ─── Криптография ─────────────────────────────────────────────────────────────
# 32 байта base64: шифрование секретов интеграций и TOTP (17-security.md §4)
KCHS_MASTER_KEY=__CHANGE_ME__
SESSION_COOKIE_NAME=kchs_session
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=30
INTERNAL_SERVICE_TOKEN=__CHANGE_ME__

# ─── Движок (Python) ──────────────────────────────────────────────────────────
ENGINE_INTERNAL_URL=http://localhost:8000

# ─── Почта ────────────────────────────────────────────────────────────────────
SMTP_URL=smtp://localhost:1025
SMTP_FROM="kchs <no-reply@kchs.local>"

# ─── Внешние каналы и ИИ (опционально) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_URL=

# ─── LiveKit (фаза 4) ────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Вход в систему: web (Caddy) ─────────────────────────────────────────────
# :80 — HTTP без сертификата (стенд, внутренняя сеть за своим TLS); домен —
# автоматический HTTPS (тогда WEB_PORT=80, WEB_HTTPS_PORT=443, S3 — тоже по HTTPS)
KCHS_DOMAIN=:80
CADDY_EMAIL=admin@example.org
# Origin объектного хранилища для браузера (схема://хост[:порт] из S3_PUBLIC_ENDPOINT,
# а если он не задан — из S3_ENDPOINT): загрузки и превью идут в S3 напрямую по
# подписанным ссылкам, CSP разрешает их только с этого origin (ADR-0043)
KCHS_STORAGE_ORIGIN=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001

# Адрес api для движка: внутри профиля app — http://api:3000,
# при разработке (api на хосте) — http://host.docker.internal:3000
ENGINE_API_URL=http://host.docker.internal:3000

# ─── Установка в контейнерах (docker compose --profile app) ─────────────────
# Порты на хосте: web — вход в систему; api и движок — только с самого сервера
WEB_PORT=8080
WEB_HTTPS_PORT=8443
API_PORT=3000
ENGINE_PORT=8000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Привязка портов БД, Redis, Meilisearch, консоли MinIO и Mailpit
KCHS_BIND=127.0.0.1
# Тег образов kchs/api, kchs/engine, kchs/web
KCHS_IMAGE_TAG=0.1.0
# Первый администратор для `kchs init` (или --admin-login / --admin-email)
KCHS_ADMIN_LOGIN=admin
KCHS_ADMIN_EMAIL=
