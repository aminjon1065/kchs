# Хранилище по HTTPS на своём имени, порт 443 (ADR-0227). Подключается надстройкой
# infra/compose/storage-subdomain.yml. Заголовок Host доходит до MinIO как есть: по нему
# сходится подпись ссылок, выданных для S3_PUBLIC_ENDPOINT (https://<это имя>).
{$KCHS_STORAGE_DOMAIN} {
	reverse_proxy minio:9000 {
		# Большие загрузки идут частями по 16 МБ; ответ на часть может задержаться
		transport http {
			response_header_timeout 5m
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
