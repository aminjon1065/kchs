# Белый список шлюза DMZ — сгенерирован из таблицы маршрутов (ADR-0200).
# Не править руками: pnpm --filter @kchs/api dmz:gen; проверка — dmz:gen --check.
# Шаблонов путей: без входа — 6, по токену API — 440,
# закрытых, заслонённых открытыми, — 2.

@kchs_dmz_closed expression <<CEL
	   (path_regexp('^/api/v1/meetings/guest/[^/]+$') && (method('GET')))
	|| (path_regexp('^/api/v1/meetings/guest/[^/]+/join$') && (method('POST')))
	CEL

@kchs_dmz_public expression <<CEL
