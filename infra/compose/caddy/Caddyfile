{
	admin off
	email {$CADDY_EMAIL:admin@example.org}
}

{$KCHS_DOMAIN:localhost} {
	encode zstd gzip

	# Внутренние маршруты движка доступны только внутри сети развёртывания
	# (engine → api:3000 напрямую); снаружи их нет
	handle /api/v1/internal/* {
		respond 404
	}

	# API и WebSocket
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /ws/* {
		reverse_proxy api:3000
	}
	handle /collab/* {
		reverse_proxy api:3000
	}

	# Статика SPA
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
		-Server
	}
}
