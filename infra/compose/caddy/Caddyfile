{
	admin off
	email {$CADDY_EMAIL:admin@example.org}
}

# Проверка живости для healthcheck контейнера web: отдельный порт без TLS и
# редиректов (с доменом основной сайт уводит HTTP на HTTPS). Наружу не публикуется
:2020 {
	respond /healthz "ok" 200
}

{$KCHS_DOMAIN:localhost} {
	encode zstd gzip

	# Внутренние маршруты движка доступны только внутри сети развёртывания
	# (engine → api:3000 напрямую); снаружи их нет. Метрики api/worker — на
	# отдельном порту 9464 для Prometheus (ADR-0045): сюда их не проксировать
	handle /api/v1/internal/* {
		respond 404
	}

	# API и WebSocket (адрес api переопределяется для проверки CSP вне compose)
	handle /api/* {
		reverse_proxy {$KCHS_API_UPSTREAM:api:3000}
	}
	handle /ws/* {
		reverse_proxy {$KCHS_API_UPSTREAM:api:3000}
	}
	handle /collab/* {
		reverse_proxy {$KCHS_API_UPSTREAM:api:3000}
	}

	# Собранные файлы с хешем в имени — кешируются навсегда
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Статика SPA. index.html — шаблон: в <meta name="csp-nonce"> подставляется
	# nonce запроса, тот же, что в заголовке CSP (ADR-0043). Такие ответы не
	# кешируются: страница из кеша несла бы nonce, не совпадающий с новым заголовком
	handle {
		root * /srv/web
		header Cache-Control "no-store"
		try_files {path} /index.html
		templates {
			mime text/html
		}
		file_server
	}

	# Страница офисного редактора (ADR-0112) — единственный ответ со своей
	# политикой: она называет сервер документов и одноразовый nonce, которые
	# знает только api. Общий заголовок её не переписывает, иначе посторонний
	# скрипт редактора не загрузился бы, а кадр запретил бы X-Frame-Options
	@site not path /api/v1/office/editor/*

	header @site {
		# Строгий CSP (17-security.md §2): скрипты — только свои файлы; стили — свои
		# файлы и <style> с nonce запроса (их вставляют Radix, react-remove-scroll и
		# react-resizable-panels во время работы). S3 — прямые загрузки и превью по
		# подписанным ссылкам (KCHS_STORAGE_ORIGIN — origin S3_PUBLIC_ENDPOINT).
		# Строку читает проверка apps/web/scripts/csp-check.mjs — меняйте только здесь
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'nonce-{http.request.uuid}'; img-src 'self' data: blob: {$KCHS_STORAGE_ORIGIN}; media-src 'self' blob: {$KCHS_STORAGE_ORIGIN} {$KCHS_MEDIA_ORIGIN}; font-src 'self'; connect-src 'self' ws://{http.request.hostport} wss://{http.request.hostport} {$KCHS_STORAGE_ORIGIN} {$KCHS_MEDIA_ORIGIN}; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
		-Server
	}
}
