  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0"."kind" AS "k", count(*) AS "n", count("q0"."title") AS "n_titles", count(DISTINCT "q0"."unit_id") AS "units", sum("q0"."damage") AS "total", avg("q0"."victims") AS "mean", min("q0"."reported_on") AS "first_day", max("q0"."reported_on") AS "last_day", percentile_cont(0.5) WITHIN GROUP (ORDER BY "q0"."damage") AS "med", percentile_cont(0.9) WITHIN GROUP (ORDER BY "q0"."damage") AS "p90", percentile_cont(0.95) WITHIN GROUP (ORDER BY "q0"."response") AS "p95", string_agg(("q0"."title")::text, ', ' ORDER BY ("q0"."title")::text) AS "titles"
  FROM "q0"
  GROUP BY 1
)
SELECT "q1"."k" AS "k", "q1"."n" AS "n", "q1"."n_titles" AS "n_titles", "q1"."units" AS "units", "q1"."total" AS "total", "q1"."mean" AS "mean", "q1"."first_day" AS "first_day", "q1"."last_day" AS "last_day", "q1"."med" AS "med", "q1"."p90" AS "p90", "q1"."p95" AS "p95", "q1"."titles" AS "titles"
FROM "q1"
LIMIT 50001
-- params: []
-- fields: k:select, n:integer, n_titles:integer, units:integer, total:money, mean:number, first_day:date, last_day:date, med:money, p90:money, p95:duration, titles:long_text
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`сводка > интервалы дат 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT date_trunc('year', ("q0"."occurred_at" AT TIME ZONE $1::text)::date)::date AS "occurred_at_year", date_trunc('quarter', ("q0"."occurred_at" AT TIME ZONE $1::text)::date)::date AS "occurred_at_quarter", date_trunc('week', ("q0"."occurred_at" AT TIME ZONE $1::text)::date)::date AS "occurred_at_week", date_trunc('day', ("q0"."occurred_at" AT TIME ZONE $1::text)::date)::date AS "occurred_at_day", date_trunc('hour', "q0"."occurred_at", $1::text) AS "occurred_at_hour", date_trunc('month', "q0"."reported_on")::date AS "month", count(*) AS "n"
  FROM "q0"
  GROUP BY 1, 2, 3, 4, 5, 6
)
SELECT "q1"."occurred_at_year" AS "occurred_at_year", "q1"."occurred_at_quarter" AS "occurred_at_quarter", "q1"."occurred_at_week" AS "occurred_at_week", "q1"."occurred_at_day" AS "occurred_at_day", "q1"."occurred_at_hour" AS "occurred_at_hour", "q1"."month" AS "month", "q1"."n" AS "n"
FROM "q1"
LIMIT 50001
-- params: ["Asia/Dushanbe"]
-- fields: occurred_at_year:date, occurred_at_quarter:date, occurred_at_week:date, occurred_at_day:date, occurred_at_hour:datetime, month:date, n:integer
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`сводка > мера по выражению-аргументу 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT sum(("q0"."damage" * "q0"."victims")) AS "total"
  FROM "q0"
)
SELECT "q1"."total" AS "total"
FROM "q1"
LIMIT 50001
-- params: []
-- fields: total:number
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`сводка > мера-выражение 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0"."kind" AS "kind", round((sum("q0"."damage")::double precision / NULLIF(count(*)::double precision, 0))::numeric, 2)::double precision AS "avg_damage", ((("q0"."kind" || $1::text) || count(*)::text) || $2::text) AS "label"
  FROM "q0"
  GROUP BY 1
)
SELECT "q1"."kind" AS "kind", "q1"."avg_damage" AS "avg_damage", "q1"."label" AS "label"
FROM "q1"
LIMIT 50001
-- params: [" (",")"]
-- fields: kind:select, avg_damage:number, label:text
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`сводка > первое и последнее по порядку добавления 1`] = `
"WITH
