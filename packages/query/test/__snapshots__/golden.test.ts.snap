exports[`соединения и объединения > объединение даты с датой и временем 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0"."reported_on" AS "at", "q0"."title" AS "title", "q0"."_id" AS "_id", "q0"."_ver" AS "_ver", "q0"."_created_at" AS "_created_at", "q0"."_updated_at" AS "_updated_at", "q0"."_created_by" AS "_created_by", "q0"."_updated_by" AS "_updated_by"
  FROM "q0"
),
"u0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "occurred_at", "c_5" AS "reported_on"
  FROM "ds"."t_archive"
  WHERE "_deleted_at" IS NULL
),
"u1" AS (
  SELECT "u0"."occurred_at" AS "at", "u0"."title" AS "title", "u0"."_id" AS "_id", "u0"."_ver" AS "_ver", "u0"."_created_at" AS "_created_at", "u0"."_updated_at" AS "_updated_at", "u0"."_created_by" AS "_created_by", "u0"."_updated_by" AS "_updated_by"
  FROM "u0"
),
"u2" AS (
  SELECT "u1"."at" AS "at", "u1"."title" AS "title"
  FROM "u1"
),
"q2" AS (
  SELECT ("q1"."at"::timestamp AT TIME ZONE $1::text) AS "at", "q1"."title" AS "title"
  FROM "q1"
  UNION ALL
  SELECT "u2"."at" AS "at", "u2"."title" AS "title"
  FROM "u2"
)
