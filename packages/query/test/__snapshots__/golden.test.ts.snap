exports[`сводка > условные меры 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0"."territory_id" AS "territory_id", count(*) FILTER (WHERE ("q0"."kind" = $1::text)) AS "fires", sum("q0"."damage") FILTER (WHERE ("q0"."kind" = $2::text)) AS "fire_damage", (count(*) FILTER (WHERE ("q0"."kind" = ANY($3::text[])))::double precision / NULLIF(1::double precision, 0)) AS "fire_share", (array_agg("q0"."occurred_at" ORDER BY "q0"."_id" DESC) FILTER (WHERE ("q0"."kind" = $4::text)))[1] AS "last_fire"
  FROM "q0"
  GROUP BY 1
)
SELECT "q1"."territory_id" AS "territory_id", "q1"."fires" AS "fires", "q1"."fire_damage" AS "fire_damage", "q1"."fire_share" AS "fire_share", "q1"."last_fire" AS "last_fire"
FROM "q1"
LIMIT 50001
-- params: ["fire","fire",["fire"],"fire"]
-- fields: territory_id:territory, fires:integer, fire_damage:money, fire_share:number, last_fire:datetime
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`сводка > фильтр по мере 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0"."kind" AS "kind", count(*) AS "n"
  FROM "q0"
