exports[`выборка, развёртка, геометрия, настройки > пояс UTC 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE ("q0"."occurred_at" >= ($1::timestamp AT TIME ZONE $2::text) AND "q0"."occurred_at" < ($3::timestamp AT TIME ZONE $2::text))
),
"q2" AS (
  SELECT date_trunc('day', ("q1"."occurred_at" AT TIME ZONE $2::text)::date)::date AS "occurred_at_day", count(*) AS "n"
  FROM "q1"
  GROUP BY 1
)
SELECT "q2"."occurred_at_day" AS "occurred_at_day", "q2"."n" AS "n"
FROM "q2"
LIMIT 50001
-- params: ["2026-09-01","UTC","2026-09-02"]
-- fields: occurred_at_day:date, n:integer
-- count: SELECT count(*) AS "count" FROM "q2""
`;

exports[`выборка, развёртка, геометрия, настройки > пример из контракта 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE (("q0"."occurred_at" >= ((date_trunc('month', ($1::timestamptz AT TIME ZONE $2::text)) + make_interval(months => $3::int)) AT TIME ZONE $2::text) AND "q0"."occurred_at" < ((date_trunc('month', ($1::timestamptz AT TIME ZONE $2::text)) + make_interval(months => $4::int)) AT TIME ZONE $2::text)) AND ("q0"."territory_id" = ANY($5::uuid[])))
),
"j0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "territory_id", "c_2" AS "name", "c_3" AS "population"
  FROM "ds"."t_regions"
  WHERE "_deleted_at" IS NULL
),
"q2" AS (
  SELECT "q1".*, "j0"."territory_id" AS "reg__territory_id", "j0"."name" AS "name", "j0"."population" AS "population"
  FROM "q1"
  LEFT JOIN "j0" ON "q1"."territory_id" = "j0"."territory_id"
),
"q3" AS (
  SELECT date_trunc('month', ("q2"."occurred_at" AT TIME ZONE $2::text)::date)::date AS "month", "q2"."name" AS "region", count(*) AS "incidents", sum("q2"."damage") AS "damage", ((count(*)::double precision / NULLIF(max("q2"."population")::double precision, 0)) * 100000) AS "per_100k"
  FROM "q2"
  GROUP BY 1, 2
),
"q4" AS (
  SELECT "q3".*, lag("q3"."incidents", 1) OVER (PARTITION BY "q3"."region" ORDER BY "q3"."month" ASC) AS "incidents_prev"
  FROM "q3"
),
"q5" AS (
  SELECT *
  FROM "q4"
  ORDER BY "q4"."month" ASC, "q4"."incidents" DESC
  LIMIT 5000
)
SELECT "q5"."month" AS "month", "q5"."region" AS "region", "q5"."incidents" AS "incidents", "q5"."damage" AS "damage", "q5"."per_100k" AS "per_100k", "q5"."incidents_prev" AS "incidents_prev"
FROM "q5"
ORDER BY "q5"."month" ASC, "q5"."incidents" DESC
LIMIT 50001
-- params: ["2026-09-18T07:30:00.000Z","Asia/Dushanbe",-12,1,["cccccccc-cccc-4ccc-8ccc-ccccccccccc1","cccccccc-cccc-4ccc-8ccc-ccccccccccc2","cccccccc-cccc-4ccc-8ccc-ccccccccccc3"]]
-- fields: month:date, region:text, incidents:integer, damage:money, per_100k:number, incidents_prev:integer
-- count: SELECT count(*) AS "count" FROM "q3""
`;

exports[`выборка, развёртка, геометрия, настройки > развёртка сохраняет остальные поля и порядок 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0"."_id", "q0"."_ver", "q0"."_created_at", "q0"."_updated_at", "q0"."_created_by", "q0"."_updated_by", "q0"."title", "q0"."kind", "q0"."damage", "q0"."victims", "q0"."occurred_at", "q0"."reported_on", "q0"."territory_id", "q0"."assignee", "q0"."unit_id", "u"."value" AS "tags", "q0"."geom", "q0"."is_confirmed", "q0"."response", "q0"."ratio", "q0"."phone", "q0"."start_time", "q0"."meta", "q0"."share", "q0"."code", "q0"."email", "q0"."notes"
  FROM "q0"
  LEFT JOIN LATERAL unnest("q0"."tags") AS "u"("value") ON TRUE
),
"q2" AS (
  SELECT "q1"."title" AS "title", "q1"."tags" AS "tags", "q1"."_id" AS "_id", "q1"."_ver" AS "_ver", "q1"."_created_at" AS "_created_at", "q1"."_updated_at" AS "_updated_at", "q1"."_created_by" AS "_created_by", "q1"."_updated_by" AS "_updated_by"
  FROM "q1"
)
SELECT "q2"."title" AS "title", "q2"."tags" AS "tags"
FROM "q2"
ORDER BY "q2"."title" ASC
LIMIT 50001
-- params: []
-- fields: title:text, tags:select
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`выборка, развёртка, геометрия, настройки > развёртка списка и подсчёт по меткам 1`] = `
