  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0"."_id", "q0"."_ver", "q0"."_created_at", "q0"."_updated_at", "q0"."_created_by", "q0"."_updated_by", "q0"."title", "q0"."kind", "q0"."damage", "q0"."victims", "q0"."occurred_at", "q0"."reported_on", "q0"."territory_id", "q0"."assignee", "q0"."unit_id", "u"."value" AS "tags", "q0"."geom", "q0"."is_confirmed", "q0"."response", "q0"."ratio", "q0"."phone", "q0"."start_time", "q0"."meta", "q0"."share", "q0"."code", "q0"."email", "q0"."notes"
  FROM "q0"
  LEFT JOIN LATERAL unnest("q0"."tags") AS "u"("value") ON TRUE
