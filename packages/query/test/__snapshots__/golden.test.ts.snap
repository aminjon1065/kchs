exports[`параметры фильтров > параметр — относительный период 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE ("q0"."occurred_at" >= ((date_trunc('month', ($1::timestamptz AT TIME ZONE $2::text)) + make_interval(months => $3::int)) AT TIME ZONE $2::text) AND "q0"."occurred_at" < ((date_trunc('month', ($1::timestamptz AT TIME ZONE $2::text)) + make_interval(months => $4::int)) AT TIME ZONE $2::text))
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email", "q1"."notes" AS "notes"
FROM "q1"
LIMIT 50001
-- params: ["2026-09-18T07:30:00.000Z","Asia/Dushanbe",-2,1]
-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, geom:geometry, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email, notes:long_text
-- count: SELECT count(*) AS "count" FROM "q1""
`;

