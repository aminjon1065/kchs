"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"j0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "territory_id", "c_2" AS "name", "c_3" AS "population"
  FROM "ds"."t_regions"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0".*, "j0"."territory_id" AS "reg__territory_id", "j0"."name" AS "name", "j0"."population" AS "population"
  FROM "q0"
  LEFT JOIN "j0" ON "q0"."territory_id" = "j0"."territory_id"
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "inc.territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email", "q1"."notes" AS "notes", "q1"."reg__territory_id" AS "reg.territory_id", "q1"."name" AS "name", "q1"."population" AS "population"
FROM "q1"
LIMIT 50001
