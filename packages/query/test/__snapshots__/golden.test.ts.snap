exports[`политики > политика источника объединения 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0"."title" AS "title", "q0"."kind" AS "kind", "q0"."damage" AS "damage", "q0"."_id" AS "_id", "q0"."_ver" AS "_ver", "q0"."_created_at" AS "_created_at", "q0"."_updated_at" AS "_updated_at", "q0"."_created_by" AS "_created_by", "q0"."_updated_by" AS "_updated_by"
  FROM "q0"
),
"u0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "occurred_at", "c_5" AS "reported_on"
  FROM "ds"."t_archive"
  WHERE "_deleted_at" IS NULL AND FALSE
),
"q2" AS (
  SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", NULL::timestamptz AS "occurred_at", NULL::date AS "reported_on"
  FROM "q1"
  UNION ALL
  SELECT "u0"."title" AS "title", "u0"."kind" AS "kind", "u0"."damage" AS "damage", "u0"."occurred_at" AS "occurred_at", "u0"."reported_on" AS "reported_on"
  FROM "u0"
)
SELECT "q2"."title" AS "title", "q2"."kind" AS "kind", "q2"."damage" AS "damage", "q2"."occurred_at" AS "occurred_at", "q2"."reported_on" AS "reported_on"
FROM "q2"
LIMIT 50001
-- params: []
-- fields: title:text, kind:select, damage:money, occurred_at:datetime, reported_on:date
-- count: SELECT count(*) AS "count" FROM "q2""
`;

exports[`политики > политика источника соединения 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"j0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "territory_id", "c_2" AS "name"
  FROM "ds"."t_regions"
  WHERE "_deleted_at" IS NULL AND ("c_1" = $1::uuid)
  OFFSET 0
),
"q1" AS (
  SELECT "q0".*, "j0"."territory_id" AS "reg__territory_id", "j0"."name" AS "name"
  FROM "q0"
  JOIN "j0" ON "q0"."territory_id" = "j0"."territory_id"
)
