exports[`шаг spatial: SQL > ближайшие больницы: кандидаты по KNN, порядок по geography 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"j0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "name", "c_2" AS "beds", "c_3" AS "geom"
  FROM "ds"."t_hospitals"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0".*, "n"."name", "n"."beds", "n"."distance_m", "n"."nearest_rank"
  FROM "q0"
  LEFT JOIN LATERAL (
    SELECT "c".*, row_number() OVER (ORDER BY "c"."distance_m") AS "nearest_rank"
    FROM (
      SELECT "j0"."name" AS "name", "j0"."beds" AS "beds", ST_Distance("q0"."geom"::geography, "j0"."geom"::geography) AS "distance_m"
      FROM "j0"
      WHERE "q0"."geom" IS NOT NULL AND "j0"."geom" IS NOT NULL AND ST_DWithin("q0"."geom"::geography, "j0"."geom"::geography, $1::double precision)
      ORDER BY "j0"."geom" <-> "q0"."geom"
      LIMIT 16
    ) AS "c"
    ORDER BY "c"."distance_m"
    LIMIT 3
  ) AS "n" ON TRUE
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email", "q1"."notes" AS "notes", "q1"."name" AS "name", "q1"."beds" AS "beds", "q1"."distance_m" AS "distance_m", "q1"."nearest_rank" AS "nearest_rank"
FROM "q1"
LIMIT 50001
-- params: [50000]
-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, geom:geometry, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email, notes:long_text, name:text, beds:integer, distance_m:number, nearest_rank:integer
-- count: SELECT count(*) AS "count" FROM "q1""
`;

