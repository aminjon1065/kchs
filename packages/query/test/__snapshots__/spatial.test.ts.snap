-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, geom:geometry, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email, notes:long_text
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`шаг spatial: SQL > площадь и длина — новыми полями 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "name", "c_2" AS "kind", "c_3" AS "geom"
  FROM "ds"."t_zones"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0".*, (ST_Area("q0"."geom"::geography) / 1000000.0) AS "area_km2"
  FROM "q0"
),
"q2" AS (
  SELECT "q1".*, (ST_Length("q1"."geom"::geography) / 1000.0) AS "perimeter_km"
  FROM "q1"
)
SELECT "q2"."name" AS "name", "q2"."kind" AS "kind", ST_AsGeoJSON("q2"."geom")::json AS "geom", "q2"."area_km2" AS "area_km2", "q2"."perimeter_km" AS "perimeter_km"
FROM "q2"
LIMIT 50001
-- params: []
-- fields: name:text, kind:select, geom:geometry, area_km2:number, perimeter_km:number
-- count: SELECT count(*) AS "count" FROM "q2""
`;

exports[`шаг spatial: SQL > присвоение района 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"j0" AS (
  SELECT "id" AS "id", "code" AS "code", "level" AS "level", "parent_id" AS "parent_id", "name" AS "name", "geom" AS "geom", "area_km2" AS "area_km2"
  FROM "ds"."sys_territories"
),
"q1" AS (
  SELECT "q0".*, (
    SELECT "j0"."id"
    FROM "j0"
    WHERE "j0"."level" = $1::text
      AND ST_Intersects("j0"."geom", ST_PointOnSurface("q0"."geom"))
    ORDER BY "j0"."code"
    LIMIT 1
  ) AS "terr"
  FROM "q0"
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email", "q1"."notes" AS "notes", "q1"."terr" AS "terr"
FROM "q1"
LIMIT 50001
-- params: ["district"]
-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, geom:geometry, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email, notes:long_text, terr:territory
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`шаг spatial: SQL > пространственное соединение в радиусе 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "name", "c_2" AS "beds", "c_3" AS "geom"
  FROM "ds"."t_hospitals"
  WHERE "_deleted_at" IS NULL
),
"j0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0".*, "s"."count"
  FROM "q0"
  LEFT JOIN LATERAL (
    SELECT count(*) AS "count"
    FROM "j0"
    WHERE ST_DWithin("q0"."geom"::geography, "j0"."geom"::geography, $1::double precision)
  ) AS "s" ON TRUE
)
SELECT "q1"."name" AS "name", "q1"."beds" AS "beds", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."count" AS "count"
FROM "q1"
LIMIT 50001
-- params: [3000]
-- fields: name:text, beds:integer, geom:geometry, count:integer
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`шаг spatial: SQL > пространственное соединение: число и сумма по объектам цели 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "name", "c_2" AS "kind", "c_3" AS "geom"
  FROM "ds"."t_zones"
  WHERE "_deleted_at" IS NULL
),
"j0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0".*, "s"."incidents", "s"."damage", "s"."last_at"
  FROM "q0"
  LEFT JOIN LATERAL (
    SELECT count(*) AS "incidents", sum("j0"."damage") AS "damage", max("j0"."occurred_at") AS "last_at"
    FROM "j0"
    WHERE ST_Intersects("q0"."geom", "j0"."geom")
  ) AS "s" ON TRUE
)
SELECT "q1"."name" AS "name", "q1"."kind" AS "kind", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."incidents" AS "incidents", "q1"."damage" AS "damage", "q1"."last_at" AS "last_at"
FROM "q1"
LIMIT 50001
-- params: []
-- fields: name:text, kind:select, geom:geometry, incidents:integer, damage:money, last_at:datetime
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`шаг spatial: SQL > расстояние до точки 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0".*, ST_Distance("q0"."geom"::geography, ST_SetSRID(ST_GeomFromGeoJSON($1::text), 4326)::geography) AS "to_center_m"
  FROM "q0"
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email", "q1"."notes" AS "notes", "q1"."to_center_m" AS "to_center_m"
FROM "q1"
LIMIT 50001
-- params: ["{\\"type\\":\\"Point\\",\\"coordinates\\":[68.78,38.56]}"]
-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, geom:geometry, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email, notes:long_text, to_center_m:number
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`шаг spatial: SQL > растворение по полю 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "name", "c_2" AS "kind", "c_3" AS "geom"
  FROM "ds"."t_zones"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT "q0"."kind" AS "kind", ST_Multi(ST_Union("q0"."geom")) AS "geom", count(*) AS "zones"
  FROM "q0"
  WHERE "q0"."geom" IS NOT NULL
  GROUP BY 1
)
SELECT "q1"."kind" AS "kind", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."zones" AS "zones"
FROM "q1"
LIMIT 50001
-- params: []
-- fields: kind:select, geom:geometry, zones:integer
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`шаг spatial: SQL > справочник территорий как источник 1`] = `
"WITH
"q0" AS (
  SELECT "id" AS "id", "code" AS "code", "level" AS "level", "parent_id" AS "parent_id", "name" AS "name", "geom" AS "geom", "area_km2" AS "area_km2"
  FROM "ds"."sys_territories"
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE ("q0"."level" = $1::text)
),
"j0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q2" AS (
  SELECT "q1".*, "s"."count"
  FROM "q1"
  LEFT JOIN LATERAL (
    SELECT count(*) AS "count"
    FROM "j0"
    WHERE ST_Intersects("q1"."geom", "j0"."geom")
  ) AS "s" ON TRUE
)
SELECT "q2"."id" AS "id", "q2"."code" AS "code", "q2"."level" AS "level", "q2"."parent_id" AS "parent_id", "q2"."name" AS "name", ST_AsGeoJSON("q2"."geom")::json AS "geom", "q2"."area_km2" AS "area_km2", "q2"."count" AS "count"
FROM "q2"
LIMIT 50001
-- params: ["district"]
-- fields: id:territory, code:identifier, level:select, parent_id:territory, name:text, geom:geometry, area_km2:number, count:integer
-- count: SELECT count(*) AS "count" FROM "q2""
`;

exports[`шаг spatial: SQL > центроид и точка на поверхности 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "name", "c_2" AS "kind", "c_3" AS "geom"
