exports[`шаг spatial: SQL > внутри территории (с поиском по идентификатору) 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"j0" AS (
  SELECT "id" AS "id", "code" AS "code", "level" AS "level", "parent_id" AS "parent_id", "name" AS "name", "geom" AS "geom", "area_km2" AS "area_km2"
  FROM "ds"."sys_territories"
),
"j1" AS (
  SELECT *
  FROM "j0"
  WHERE ("j0"."id" = ANY($1::uuid[]))
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE EXISTS (SELECT 1 FROM "j1" WHERE ST_Within("q0"."geom", "j1"."geom"))
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email", "q1"."notes" AS "notes"
FROM "q1"
LIMIT 50001
-- params: [["cccccccc-cccc-4ccc-8ccc-ccccccccccc1"]]
-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, geom:geometry, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email, notes:long_text
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`шаг spatial: SQL > вырезание по территориям уровня 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "name", "c_2" AS "kind", "c_3" AS "geom"
  FROM "ds"."t_zones"
  WHERE "_deleted_at" IS NULL
),
"j0" AS (
  SELECT "id" AS "id", "code" AS "code", "level" AS "level", "parent_id" AS "parent_id", "name" AS "name", "geom" AS "geom", "area_km2" AS "area_km2"
  FROM "ds"."sys_territories"
),
"j1" AS (
  SELECT *
  FROM "j0"
  WHERE ("j0"."level" = $1::text)
),
"q1" AS (
  SELECT ST_Union("j1"."geom") AS "clip"
  FROM "j1"
  WHERE "j1"."geom" IS NOT NULL
),
"q2" AS (
  SELECT "q0"."_id", "q0"."_ver", "q0"."_created_at", "q0"."_updated_at", "q0"."_created_by", "q0"."_updated_by", "q0"."name", "q0"."kind", ST_CollectionExtract(ST_Intersection("q0"."geom", "m"."clip"), ST_Dimension("q0"."geom") + 1) AS "geom"
  FROM "q0"
  CROSS JOIN "q1" AS "m"
  WHERE ST_Intersects("q0"."geom", "m"."clip")
),
"q3" AS (
  SELECT *
  FROM "q2"
  WHERE NOT ST_IsEmpty("q2"."geom")
)
SELECT "q3"."name" AS "name", "q3"."kind" AS "kind", ST_AsGeoJSON("q3"."geom")::json AS "geom"
FROM "q3"
LIMIT 50001
-- params: ["region"]
-- fields: name:text, kind:select, geom:geometry
-- count: SELECT count(*) AS "count" FROM "q3""
`;

exports[`шаг spatial: SQL > квадратная сетка: число объектов 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT (CASE WHEN ST_Y("c") < 0 THEN 32700 ELSE 32600 END
    + LEAST(60, GREATEST(1, floor((ST_X("c") + 180) / 6)::int + 1)))::int AS "srid"
  FROM (SELECT ST_Centroid(ST_Extent("q0"."geom")::geometry) AS "c" FROM "q0") AS "e"
),
"q2" AS (
  SELECT "h"."i" AS "i", "h"."j" AS "j", count(*) AS "count"
  FROM "q0"
  CROSS JOIN "q1" AS "z"
  CROSS JOIN LATERAL ST_SquareGrid($1::double precision, ST_Transform("q0"."geom", "z"."srid")) AS "h"
  WHERE "q0"."geom" IS NOT NULL AND NOT ST_IsEmpty("q0"."geom") AND ST_Intersects("h"."geom", ST_Transform("q0"."geom", "z"."srid"))
  GROUP BY 1, 2
),
"q3" AS (
  SELECT concat("q2"."i", ':', "q2"."j") AS "cell", ST_Transform(ST_SetSRID(ST_Square($1::double precision, "q2"."i", "q2"."j"), "z"."srid"), 4326) AS "geom", "q2"."count"
  FROM "q2"
  CROSS JOIN "q1" AS "z"
)
SELECT "q3"."cell" AS "cell", ST_AsGeoJSON("q3"."geom")::json AS "geom", "q3"."count" AS "count"
FROM "q3"
LIMIT 50001
-- params: [10000]
-- fields: cell:identifier, geom:geometry, count:integer
-- count: SELECT count(*) AS "count" FROM "q3""
`;

exports[`шаг spatial: SQL > не в радиусе больниц цели с условием 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"j0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "name", "c_2" AS "beds", "c_3" AS "geom"
  FROM "ds"."t_hospitals"
  WHERE "_deleted_at" IS NULL
),
"j1" AS (
  SELECT *
  FROM "j0"
  WHERE ("j0"."beds" >= $2::bigint)
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE "q0"."geom" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM "j1" WHERE ST_DWithin("q0"."geom"::geography, "j1"."geom"::geography, $1::double precision))
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email", "q1"."notes" AS "notes"
FROM "q1"
LIMIT 50001
-- params: [2000,50]
-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, geom:geometry, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email, notes:long_text
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`шаг spatial: SQL > пересечение с геометрией GeoJSON 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE ST_Intersects("q0"."geom", ST_SetSRID(ST_GeomFromGeoJSON($1::text), 4326))
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", ST_AsGeoJSON("q1"."geom")::json AS "geom", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email", "q1"."notes" AS "notes"
FROM "q1"
LIMIT 50001
