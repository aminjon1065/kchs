`;

exports[`шаг spatial: SQL > цепочка: фильтр, буфер, площадь, сортировка и лимит 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE ("q0"."kind" = $1::text)
),
"q2" AS (
  SELECT "q1"."_id", "q1"."_ver", "q1"."_created_at", "q1"."_updated_at", "q1"."_created_by", "q1"."_updated_by", "q1"."title", "q1"."kind", "q1"."damage", "q1"."victims", "q1"."occurred_at", "q1"."reported_on", "q1"."territory_id", "q1"."assignee", "q1"."unit_id", "q1"."tags", ST_Buffer("q1"."geom"::geography, $2::double precision)::geometry AS "geom", "q1"."is_confirmed", "q1"."response", "q1"."ratio", "q1"."phone", "q1"."start_time", "q1"."meta", "q1"."share", "q1"."code", "q1"."email", "q1"."notes"
  FROM "q1"
),
"q3" AS (
  SELECT "q2".*, (ST_Area("q2"."geom"::geography) / 1000000.0) AS "area_km2"
  FROM "q2"
),
"q4" AS (
  SELECT *
  FROM "q3"
  ORDER BY "q3"."damage" DESC
  LIMIT 10
)
SELECT "q4"."title" AS "title", "q4"."kind" AS "kind", "q4"."damage" AS "damage", "q4"."victims" AS "victims", "q4"."occurred_at" AS "occurred_at", "q4"."reported_on" AS "reported_on", "q4"."territory_id" AS "territory_id", "q4"."assignee" AS "assignee", "q4"."unit_id" AS "unit_id", "q4"."tags" AS "tags", ST_AsGeoJSON("q4"."geom")::json AS "geom", "q4"."is_confirmed" AS "is_confirmed", "q4"."response" AS "response", "q4"."ratio" AS "ratio", "q4"."phone" AS "phone", "q4"."start_time" AS "start_time", "q4"."meta" AS "meta", "q4"."share" AS "share", "q4"."code" AS "code", "q4"."email" AS "email", "q4"."notes" AS "notes", "q4"."area_km2" AS "area_km2"
FROM "q4"
ORDER BY "q4"."damage" DESC
LIMIT 50001
-- params: ["fire",1000]
-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, geom:geometry, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email, notes:long_text, area_km2:number
-- count: SELECT count(*) AS "count" FROM "q3""
`;

exports[`шаг spatial: SQL > шестиугольники с мерами 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "geom", "c_12" AS "is_confirmed", (extract(epoch FROM "c_13") / 60)::double precision AS "response", "c_14" AS "ratio", "c_15" AS "phone", "c_16" AS "start_time", "c_17" AS "meta", "c_19" AS "share", "c_20" AS "code", "c_21" AS "email", "c_22" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT (CASE WHEN ST_Y("c") < 0 THEN 32700 ELSE 32600 END
    + LEAST(60, GREATEST(1, floor((ST_X("c") + 180) / 6)::int + 1)))::int AS "srid"
  FROM (SELECT ST_Centroid(ST_Extent("q0"."geom")::geometry) AS "c" FROM "q0") AS "e"
),
"q2" AS (
  SELECT "h"."i" AS "i", "h"."j" AS "j", count(*) AS "n", avg("q0"."damage") AS "damage"
  FROM "q0"
  CROSS JOIN "q1" AS "z"
  CROSS JOIN LATERAL ST_HexagonGrid($1::double precision, ST_Transform("q0"."geom", "z"."srid")) AS "h"
  WHERE "q0"."geom" IS NOT NULL AND NOT ST_IsEmpty("q0"."geom") AND ST_Intersects("h"."geom", ST_Transform("q0"."geom", "z"."srid"))
  GROUP BY 1, 2
),
"q3" AS (
  SELECT concat("q2"."i", ':', "q2"."j") AS "cell", ST_Transform(ST_SetSRID(ST_Hexagon($1::double precision, "q2"."i", "q2"."j"), "z"."srid"), 4326) AS "geom", "q2"."n", "q2"."damage"
  FROM "q2"
  CROSS JOIN "q1" AS "z"
)
SELECT "q3"."cell" AS "cell", ST_AsGeoJSON("q3"."geom")::json AS "geom", "q3"."n" AS "n", "q3"."damage" AS "damage"
FROM "q3"
LIMIT 50001
-- params: [5000]
-- fields: cell:identifier, geom:geometry, n:integer, damage:money
-- count: SELECT count(*) AS "count" FROM "q3""
`;
