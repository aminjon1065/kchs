`;

exports[`DuckDB: выборка и агрегаты > фильтры: список, шаблон, регулярное выражение, множественный выбор 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "is_confirmed", CAST("c_12" AS DOUBLE) AS "response", "c_13" AS "ratio", "c_14" AS "phone", "c_15" AS "start_time", "c_16" AS "meta", "c_17" AS "share", "c_18" AS "code", "c_19" AS "email", "c_20" AS "notes"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE ((list_contains(CAST($1 AS VARCHAR[]), "q0"."kind")) AND ("q0"."title" ILIKE CAST($2 AS VARCHAR) ESCAPE '\\') AND (regexp_matches("q0"."title", CAST($3 AS VARCHAR), 'i')) AND (list_has_any("q0"."tags", CAST($4 AS VARCHAR[]))) AND ("q0"."victims" > CAST($5 AS BIGINT)))
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email", "q1"."notes" AS "notes"
FROM "q1"
LIMIT 50001
-- params: [["fire","flood"],"%склад%","^A\\\\d+",["крупное","ночное"],3]
-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email, notes:long_text
-- count: SELECT count(*) AS "count" FROM "q1""
`;

exports[`DuckDB: политики > столбцы: маска не обходится фильтром 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", CAST((CASE WHEN "c_3" IS NULL OR "c_3" = 0 THEN "c_3" ELSE round(CAST(("c_3") AS DOUBLE), CAST((1 - floor(log(abs(CAST(("c_3") AS DOUBLE))))) AS INTEGER)) END) AS DECIMAL(38,12)) AS "damage", "c_4" AS "victims", ((date_trunc('year', "c_5" AT TIME ZONE CAST($1 AS VARCHAR))) AT TIME ZONE CAST($1 AS VARCHAR)) AS "occurred_at", CAST(date_trunc('year', "c_6") AS DATE) AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "is_confirmed", CAST("c_12" AS DOUBLE) AS "response", CAST((CASE WHEN "c_13" IS NULL OR "c_13" = 0 THEN "c_13" WHEN (isnan("c_13") OR isinf("c_13")) THEN NULL ELSE round(CAST(("c_13") AS DOUBLE), CAST((1 - floor(log(abs(CAST(("c_13") AS DOUBLE))))) AS INTEGER)) END) AS DOUBLE) AS "ratio", (CASE WHEN "c_14" IS NULL THEN NULL WHEN length("c_14") >= 8 THEN '***' || right("c_14", 4) ELSE '***' END) AS "phone", "c_15" AS "start_time", "c_16" AS "meta", "c_17" AS "share", (CASE WHEN "c_18" IS NULL THEN NULL WHEN length("c_18") >= 8 THEN '***' || right("c_18", 4) ELSE '***' END) AS "code", (CASE WHEN "c_19" IS NULL THEN NULL ELSE '***@' || split_part("c_19", '@', 2) END) AS "email"
  FROM "ds"."t_incidents"
  WHERE "_deleted_at" IS NULL
),
"q1" AS (
  SELECT *
  FROM "q0"
  WHERE ("q0"."phone" ILIKE CAST($2 AS VARCHAR) ESCAPE '\\')
)
SELECT "q1"."title" AS "title", "q1"."kind" AS "kind", "q1"."damage" AS "damage", "q1"."victims" AS "victims", "q1"."occurred_at" AS "occurred_at", "q1"."reported_on" AS "reported_on", "q1"."territory_id" AS "territory_id", "q1"."assignee" AS "assignee", "q1"."unit_id" AS "unit_id", "q1"."tags" AS "tags", "q1"."is_confirmed" AS "is_confirmed", "q1"."response" AS "response", "q1"."ratio" AS "ratio", "q1"."phone" AS "phone", "q1"."start_time" AS "start_time", "q1"."meta" AS "meta", "q1"."share" AS "share", "q1"."code" AS "code", "q1"."email" AS "email"
FROM "q1"
LIMIT 50001
-- params: ["Asia/Dushanbe","%992%"]
-- fields: title:text, kind:select, damage:money, victims:integer, occurred_at:datetime, reported_on:date, territory_id:territory, assignee:user, unit_id:unit, tags:multi_select, is_confirmed:boolean, response:duration, ratio:number, phone:phone, start_time:time, meta:json, share:percent, code:identifier, email:email
-- count: SELECT count(*) AS "count" FROM "q1""
`;

