exports[`DuckDB: политики > строки: политика и барьер 1`] = `
"WITH
"q0" AS (
  SELECT "_id", "_ver", "_created_at", "_updated_at", "_created_by", "_updated_by", "c_1" AS "title", "c_2" AS "kind", "c_3" AS "damage", "c_4" AS "victims", "c_5" AS "occurred_at", "c_6" AS "reported_on", "c_7" AS "territory_id", "c_8" AS "assignee", "c_9" AS "unit_id", "c_10" AS "tags", "c_11" AS "is_confirmed", CAST("c_12" AS DOUBLE) AS "response", "c_13" AS "ratio", "c_14" AS "phone", "c_15" AS "start_time", "c_16" AS "meta", "c_17" AS "share", "c_18" AS "code", "c_19" AS "email", "c_20" AS "notes"
