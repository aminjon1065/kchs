),
"q1" AS (
  SELECT "q0"."response" AS "response", "q0"."_id" AS "_id", "q0"."_ver" AS "_ver", "q0"."_created_at" AS "_created_at", "q0"."_updated_at" AS "_updated_at", "q0"."_created_by" AS "_created_by", "q0"."_updated_by" AS "_updated_by"
  FROM "q0"
