{
  "$comment": "Источник правды дизайн-системы (03-ui/02-design-system.md). CSS-переменные генерируются скриптом tokens.",
  "color": {
    "neutral": {
      "bg-canvas": { "light": "#F6F6F7", "dark": "#0E0F11", "use": "фон приложения" },
      "bg-surface": { "light": "#FFFFFF", "dark": "#16171A", "use": "панели, карточки, таблицы" },
      "bg-surface-2": {
        "light": "#F1F1F3",
        "dark": "#1D1E22",
        "use": "вторичные области, заголовки таблиц, навигатор"
      },
      "bg-surface-3": { "light": "#E9E9EC", "dark": "#25262B", "use": "hover, выделение строк" },
      "bg-overlay": { "light": "#FFFFFF", "dark": "#1D1E22", "use": "всплывающие окна и меню" },
      "border": { "light": "#E4E4E8", "dark": "#2A2B31", "use": "делители, рамки" },
      "border-strong": { "light": "#D2D2D8", "dark": "#3A3B42", "use": "рамки контролов, hover" },
      "text": { "light": "#17181C", "dark": "#ECECEF", "use": "основной текст" },
      "text-secondary": { "light": "#4F5160", "dark": "#A6A7B2", "use": "подписи, вторичное" },
      "text-muted": { "light": "#7B7D8C", "dark": "#7B7D8C", "use": "плейсхолдеры, третичное" },
      "text-inverse": { "light": "#FFFFFF", "dark": "#0E0F11", "use": "текст на акценте" }
    },
    "accent": {
      "accent": { "light": "#2F62E6", "dark": "#7EA0FF" },
      "accent-hover": { "light": "#2653C4", "dark": "#95B1FF" },
      "accent-subtle": { "light": "#E9EFFF", "dark": "#1A2440" },
      "accent-ring": { "light": "rgba(47,98,230,.35)", "dark": "rgba(126,160,255,.4)" },
      "accent-fg": { "light": "#FFFFFF", "dark": "#0E0F11" }
    },
    "semantic": {
      "success": { "light": "#1C9A62", "dark": "#4CCB8E" },
      "success-subtle": { "light": "#E6F6EE", "dark": "#0F2A1E" },
      "warning": { "light": "#C98A00", "dark": "#F2B84B" },
      "warning-subtle": { "light": "#FFF5DC", "dark": "#332A10" },
      "danger": { "light": "#D63B3B", "dark": "#F06B6B" },
      "danger-subtle": { "light": "#FDEAEA", "dark": "#3A1717" },
      "info": { "light": "#2F62E6", "dark": "#7EA0FF" },
      "info-subtle": { "light": "#E9EFFF", "dark": "#1A2440" },
      "purple": { "light": "#8B5CF6", "dark": "#A78BFA" },
      "purple-subtle": { "light": "#F1ECFE", "dark": "#231A3D" }
    },
    "categorical": {
      "light": [
        "#2F62E6",
        "#E8842F",
        "#1C9A62",
        "#D63B3B",
        "#8B5CF6",
        "#0EA5B7",
        "#C9A227",
        "#D9509C",
        "#5B7083",
        "#7C5C3B"
      ],
      "dark": [
        "#6B93FF",
        "#F59B55",
        "#4CCB8E",
        "#F06B6B",
        "#A78BFA",
        "#3BC4D4",
        "#E0BC48",
        "#EC77B4",
        "#8497A8",
        "#A67F5C"
      ]
    },
    "sequential": {
      "blue": ["#E9EFFF", "#C6D6FA", "#9DB9F2", "#6E96E9", "#4573DD", "#2F62E6", "#1A3A9E"],
      "teal": ["#E3F6F8", "#BCE9EE", "#8CD8E1", "#57C2CF", "#2BA6B6", "#0EA5B7", "#0A6B77"],
      "orange": ["#FDF0E4", "#F9D9BC", "#F3BC8D", "#EE9E5F", "#E8842F", "#C96B1E", "#8F4A12"]
    },
    "diverging": {
      "red-blue": ["#D63B3B", "#E98080", "#F5C0C0", "#F1F1F3", "#BCD0F7", "#7DA0EC", "#2F62E6"]
    },
    "status": {
      "draft": { "token": "text-muted" },
      "in_progress": { "token": "accent" },
      "on_approval": { "token": "purple" },
      "done": { "token": "success" },
      "overdue": { "token": "danger" },
      "cancelled": { "token": "text-muted" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter var', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "scale": {
      "2xs": { "size": "11px", "line": "16px", "weight": 500, "tracking": "0" },
      "xs": { "size": "12px", "line": "16px", "weight": 400, "tracking": "0" },
      "sm": { "size": "13px", "line": "20px", "weight": 400, "tracking": "0" },
      "base": { "size": "14px", "line": "22px", "weight": 400, "tracking": "0" },
      "md": { "size": "16px", "line": "24px", "weight": 500, "tracking": "-0.005em" },
      "lg": { "size": "18px", "line": "26px", "weight": 600, "tracking": "-0.008em" },
      "xl": { "size": "22px", "line": "30px", "weight": 600, "tracking": "-0.01em" },
      "2xl": { "size": "28px", "line": "36px", "weight": 600, "tracking": "-0.015em" },
      "3xl": { "size": "36px", "line": "44px", "weight": 600, "tracking": "-0.02em" }
    }
  },
  "space": {
    "1": "4px",
    "1.5": "6px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": { "xs": "4px", "sm": "6px", "md": "8px", "lg": "12px", "full": "9999px" },
  "shadow": {
    "sm": { "light": "0 1px 2px rgba(16,17,20,.06)", "dark": "0 1px 2px rgba(0,0,0,.4)" },
    "md": {
      "light": "0 4px 12px rgba(16,17,20,.08), 0 1px 3px rgba(16,17,20,.06)",
      "dark": "0 4px 12px rgba(0,0,0,.45), 0 1px 3px rgba(0,0,0,.3)"
    },
    "lg": {
      "light": "0 12px 32px rgba(16,17,20,.14), 0 2px 6px rgba(16,17,20,.08)",
      "dark": "0 12px 32px rgba(0,0,0,.55), 0 2px 6px rgba(0,0,0,.4)"
    }
  },
  "density": {
    "comfortable": {
      "control-h": "32px",
      "row-h": "36px",
      "list-row-h": "44px",
      "card-pad": "16px",
      "tab-h": "36px"
    },
    "compact": {
      "control-h": "28px",
      "row-h": "30px",
      "list-row-h": "36px",
      "card-pad": "12px",
      "tab-h": "32px"
    }
  },
  "motion": {
    "duration": { "fast": "100ms", "base": "150ms", "slow": "200ms", "modal": "250ms" },
    "easing": {
      "standard": "cubic-bezier(.2,0,0,1)",
      "exit": "cubic-bezier(.4,0,1,1)",
      "spring": "cubic-bezier(.2,1.2,.3,1)"
    }
  },
  "layer": {
    "base": 0,
    "sticky": 10,
    "panel": 20,
    "dropdown": 30,
    "overlay": 40,
    "modal": 50,
    "toast": 60,
    "tooltip": 70
  },
  "layout": {
    "rail-w": "56px",
    "navigator-w": "260px",
    "context-w": "320px",
    "topbar-h": "44px",
    "statusbar-h": "26px"
  }
}
