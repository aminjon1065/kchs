  "devDependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@kchs/config": "workspace:*",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.9",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "dependency-cruiser": "^17.0.1",
    "drizzle-kit": "^0.31.5",
    "esbuild": "0.28.2",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
